generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// *
///  * Category: Main financial industry groups
///  * Examples: Investment Banking, Corporate Finance, Accounting
model Category {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @db.VarChar(255)
  slug        String     @unique @db.VarChar(100)
  description String
  icon        String     @db.VarChar(50)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)
  questions   Question[]

  @@map("categories")
}

/// *
///  * TestType: Distinguishes between technical knowledge and fit/soft skills
///  * Examples: Technical, Behavioral
model TestType {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @db.VarChar(255)
  slug        String     @unique @db.VarChar(100)
  description String
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)
  questions   Question[]

  @@map("test_types")
}

/// *
///  * Question: Individual interview questions
///  * Linked to a specific category and test type
model Question {
  id         String     @id @default(uuid()) @db.Uuid
  content    String
  difficulty Difficulty @default(MEDIUM)
  source     String?    @db.VarChar(255)
  order      Int        @default(0)
  categoryId String     @db.Uuid
  testTypeId String     @db.Uuid
  createdAt  DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @db.Timestamptz(6)
  answers    Answer[]
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  testType   TestType   @relation(fields: [testTypeId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([testTypeId])
  @@index([difficulty])
  @@map("questions")
}

/// *
///  * Answer: Potential answers or model responses for a question
model Answer {
  id          String   @id @default(uuid()) @db.Uuid
  content     String
  isCorrect   Boolean  @default(false)
  explanation String?
  questionId  String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("answers")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}
